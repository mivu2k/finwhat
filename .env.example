# Database: pick ONE.
#  SQLite: one file, nothing to install (good for testing / small teams).
DATABASE_URL=sqlite:./data/expensechat.db
#  MySQL 8: for real multi-user load.
# DATABASE_URL=mysql://expensechat:CHANGE_ME@127.0.0.1:3306/expensechat
JWT_SECRET=generate-with-openssl-rand-hex-32
PORT=4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# optional AI (Phase 2). Without them voice/photo threads stay "Draft / Needs form" and are filled manually.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# EXTRACT_MODEL=claude-opus-5-5
# TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions   (any Whisper-compatible endpoint)
# Password reset emails, e.g. smtps://user:pass@smtp.example.com:465 (without it the code is printed in the server log)
# SMTP_URL=
# MAIL_FROM=ExpenseChat <no-reply@example.com>
